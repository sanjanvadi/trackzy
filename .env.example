# Copy this to .env — never commit .env or serviceAccount.json

# Groq (free at console.groq.com) — covers both Whisper and LLM
GROQ_API_KEY=gsk_....

# Firebase Admin SDK service account JSON path
GOOGLE_APPLICATION_CREDENTIALS=./serviceAccount.json

# PostgreSQL connection string (free at neon.tech)
# Format: postgresql+asyncpg://user:password@host/dbname
DATABASE_URL=postgresql+asyncpg://neondb_owner:npg_...

# App environment
ENV=development
ALLOWED_ORIGINS=http://localhost:8081,http://localhost:3000
